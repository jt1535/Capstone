    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Takeaways'>
      <style />
      <size maxheight='860' maxwidth='650' minheight='560' minwidth='420' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98062' id='3' type-v2='text' w='97538' x='1231' y='969'>
            <formatted-text>
              <run fontalignment='1' fontcolor='#4e79a7' fontsize='12'>Takeaways:</run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run fontalignment='1' fontcolor='#4e79a7' fontsize='12'>- Total Offense for the most part affected winning</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run fontalignment='1' fontcolor='#4e79a7' fontsize='12'>- Location did not affect Offensive output or winning %</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run fontalignment='1' fontcolor='#4e79a7' fontsize='12'>- Time of Possession did not really affect</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run fontalignment='1' fontcolor='#4e79a7' fontsize='12'>- Turnover Rank affect</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run fontalignment='1' fontcolor='#4e79a7' fontsize='12'>- Total Points are not factor</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run fontalignment='1' fontcolor='#4e79a7' fontsize='12'>- Red Zone Rank is not a factor</run>
